#include "../include/FrequencyTable.hpp"

FrequencyTable::FrequencyTable() {
    total = 0;

    for (int i = 0; i < capacity; i++) {
        values[i] = 0;
        counts[i] = 0;
    }
}

bool FrequencyTable::addDelta(int delta) {
    for (int i = 0; i < total; i++) {
        if (values[i] == delta) {
            counts[i]++;
            return true;
        }
    }

    if (total == capacity)
        return false;

    values[total] = delta;
    counts[total] = 1;
    total++;
    return true;
}
